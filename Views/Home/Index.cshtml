<head>
    <title>Integrantes de mi grupo</title>
</head>
<body>
    <p>Integrantes de mi grupo:</p>
<ul>
@foreach (Integrante integrante in ViewBag.Integrantes){
    <li>
        <a href='@Url.Action("DetalleIntegrante", "Home", new {id = integrante.getDNI()})'>@integrante.getNombre()</a>
    </li>
}
</ul>
</body>
