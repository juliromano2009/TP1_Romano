<head>
    <title>Integrantes de mi grupo</title>
</head>
<body>
    <h1>Integrantes de mi grupo:</h1>
<div>
    <ul>
        @foreach (Integrante integrante in ((System.Collections.Generic.Dictionary<int, inicio.Models.Integrante>)ViewBag.Integrantes).Values)
        {
            <li>
                <a href='@Url.Action("DetalleIntegrante", "Home", new { dni = integrante.getDNI() })'>@integrante.getNombre()</a>
            </li>
        }   
    </ul>
</div>
</body>
<footer>
    <p>Hecho por Juli y Jaz</p>
</footer>
